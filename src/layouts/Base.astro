---
import "@fontsource-variable/fraunces/opsz.css";
import "@fontsource-variable/fraunces/opsz-italic.css";
import "@fontsource-variable/public-sans";
import "@fontsource-variable/literata/opsz.css";
import "@fontsource-variable/literata/opsz-italic.css";
import "@fontsource/special-elite";
import "@fontsource/reenie-beanie";
import "@/styles/tokens.css";
import "@/styles/base.css";
import { t, typo } from "@/content";

interface Props {
  title?: string;
  description?: string;
}

const { title = t.meta.title, description = t.meta.description } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{typo(title)}</title>
    <meta name="description" content={typo(description)} />
    <meta name="theme-color" content="#2e4a3b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={typo(title)} />
    <meta property="og:description" content={typo(description)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      {typo(t.meta.skipLink)}
    </a>
    <slot />
    <script>
      import "@/scripts/main";
    </script>
  </body>
</html>
