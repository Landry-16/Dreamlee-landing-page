---
import { Image } from "astro:assets";
import logo from "@/assets/logo.png";
import { t, typo } from "@/content";
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="nav__brand" href="#top" aria-label={typo(t.nav.home)}>
      <Image src={logo} alt="" width={28} height={28} class="nav__logo" />
      <span>Dreamlee</span>
    </a>
    <nav class="nav__menu" id="menu" aria-label={typo(t.nav.label)} data-menu>
      <ul>
        {t.nav.links.map((link) => (
          <li>
            <a href={link.href}>{typo(link.label)}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="nav__cta" href="#beta">
      {typo(t.nav.cta)}
    </a>
    <button
      class="nav__burger"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      data-menu-toggle
      data-open-label={typo(t.nav.openMenu)}
      data-close-label={typo(t.nav.closeMenu)}
    >
      <span class="visually-hidden" data-menu-label>
        {typo(t.nav.openMenu)}
      </span>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--on-dark);
    transition:
      transform 260ms var(--ease-out),
      background-color 260ms;
  }

  .nav[data-state="scrolled"] {
    background: rgb(22 36 28 / 0.9);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.06);
  }

  .nav[data-state="hidden"] {
    transform: translateY(-100%);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 40px;
    max-width: 1440px;
    height: 72px;
    margin-inline: auto;
    padding-inline: 48px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    text-decoration: none;
  }

  .nav__logo {
    border-radius: 6px;
  }

  .nav__menu ul {
    display: flex;
    gap: 28px;
    padding: 0;
    list-style: none;
  }

  .nav__menu a {
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    opacity: 0.88;
  }

  .nav__menu a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }

  .nav__cta {
    margin-left: auto;
    padding: 10px 18px;
    border-radius: 6px;
    background: var(--paper);
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--shadow-low);
    transition: transform 140ms var(--ease-out);
  }

  .nav__cta:hover {
    transform: translateY(-1px) rotate(-1deg);
  }

  .nav__burger {
    display: none;
    padding: 8px;
    border: 0;
    background: none;
  }

  @media (max-width: 899.98px) {
    .nav__inner {
      gap: 12px;
      height: 64px;
      padding-inline: 20px;
    }

    .nav__cta {
      padding: 8px 12px;
      font-size: 14px;
    }

    .nav__burger {
      display: block;
    }

    .nav__menu {
      position: absolute;
      top: 64px;
      right: 16px;
      left: 16px;
      padding: 12px;
      border-radius: 6px;
      background: var(--paper);
      color: var(--text);
      box-shadow: var(--shadow-sheet);
      transform-origin: top right;
      transition:
        opacity 180ms,
        transform 180ms var(--ease-out),
        visibility 180ms;
    }

    .nav__menu:not([data-open]) {
      visibility: hidden;
      opacity: 0;
      transform: scale(0.96) rotate(-1deg);
    }

    .nav__menu ul {
      flex-direction: column;
      gap: 0;
    }

    .nav__menu a {
      display: block;
      padding: 12px;
      font-size: 17px;
    }
  }
</style>
