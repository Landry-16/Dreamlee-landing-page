---
import { Image } from "astro:assets";
import schema from "@/assets/app-schema.png";
import { t, typo } from "@/content";
import { place } from "@/lib/place";

const u = t.universe;

/** Where each card sits on the wide board (Figma frame) and on narrow screens. */
const layout: Record<
  string,
  { wide: [number, number, number]; narrow?: [number, number, number] }
> = {
  maelle: { wide: [640, 170, 3], narrow: [4, 0, -3] },
  aubin: { wide: [1010, 110, -4], narrow: [50, 150, 4] },
  phare: { wide: [1120, 440, 2], narrow: [6, 320, 2] },
  lanterne: { wide: [690, 560, -3], narrow: [50, 470, -3] },
  guilde: { wide: [1130, 760, 4] },
  incendie: { wide: [560, 800, -2] },
};
---

<section class="universe section surface" id="univers" aria-labelledby="universe-title" data-board>
  <div class="stage">
    <div class="canvas" style="--h:1000">
      <div class="universe__note at paper" style={place(80, 110, 460, 1.5)}>
        <span class="pin universe__note-pin" aria-hidden="true"></span>
        <h2 class="section-title universe__title" id="universe-title">
          {typo(u.title)}
        </h2>
        {u.body.map((paragraph) => (
          <p class="universe__body">{typo(paragraph)}</p>
        ))}
      </div>

      <figure class="universe__app at only-wide" style={place(100, 640, 420, -2)}>
        <Image src={schema} alt={typo(u.screenshotAlt)} widths={[480, 840]} sizes="30vw" />
        <figcaption class="hand">{typo(u.screenshotCaption)}</figcaption>
      </figure>

      <div class="universe__board" data-board-area>
        <p class="visually-hidden" id="board-help">
          {typo(u.dragHint)}. Flèches du clavier pour déplacer la fiche sélectionnée.
        </p>
        <svg class="universe__threads" aria-hidden="true" data-threads></svg>
        <ul class="universe__relations" aria-label="Liens entre les fiches">
          {u.relations.map((relation) => {
            const from = u.entries.find((entry) => entry.id === relation.from);
            const to = u.entries.find((entry) => entry.id === relation.to);
            const narrow = Boolean(layout[relation.from]?.narrow && layout[relation.to]?.narrow);
            return (
              <li
                class:list={["universe__tag", "hand", !narrow && "universe__wide-only"]}
                data-from={relation.from}
                data-to={relation.to}
              >
                <span class="visually-hidden">{typo(from?.name ?? "")} </span>
                {typo(relation.label)}
                <span class="visually-hidden"> {typo(to?.name ?? "")}</span>
              </li>
            );
          })}
        </ul>
        {u.entries.map((entry) => {
          const spot = layout[entry.id];
          const [x, y, r] = spot?.wide ?? [0, 0, 0];
          const [nx, ny, nr] = spot?.narrow ?? [0, 0, 0];
          return (
            <article
              class:list={[
                "universe__card",
                `universe__card--${entry.category}`,
                !spot?.narrow && "universe__wide-only",
              ]}
              style={`--x:${x};--y:${y};--r:${r};--nx:${nx};--ny:${ny};--nr:${nr}`}
              tabindex="0"
              aria-roledescription="fiche déplaçable"
              aria-describedby="board-help"
              data-card={entry.id}
            >
              <span class="pin universe__pin" aria-hidden="true" data-pin />
              <p class="universe__kind">{typo(entry.kind)}</p>
              <h3 class="universe__name">{typo(entry.name)}</h3>
              <p class="universe__text typewriter">{typo(entry.text)}</p>
            </article>
          );
        })}
      </div>

      <p class="universe__hint hand only-narrow" aria-hidden="true">
        {typo(u.screenshotCaption)}
      </p>
    </div>
  </div>
</section>

<style>
  .universe {
    --base: var(--cork);
    --grain-strength: 0.55;
    background:
      radial-gradient(ellipse at 60% 40%, rgb(230 210 174 / 0.5), transparent 70%),
      radial-gradient(ellipse at 50% 50%, transparent 60%, rgb(100 70 40 / 0.35)), var(--cork);
  }

  .universe::before {
    background-image:
      var(--grain),
      radial-gradient(circle at 20% 30%, rgb(120 85 45 / 0.35) 0 1.5px, transparent 2px),
      radial-gradient(circle at 70% 60%, rgb(120 85 45 / 0.3) 0 1px, transparent 1.5px);
    background-size:
      auto,
      23px 29px,
      17px 13px;
  }

  .universe__note {
    --sheet: var(--paper);
    padding: 52px 44px 44px;
    z-index: 3;
  }

  .universe__note-pin {
    top: 8px;
    left: 50%;
    background: radial-gradient(circle at 35% 30%, #7da0cf, #3c5d8f 55%, #1e3358);
  }

  .universe__title {
    color: var(--ink);
  }

  .universe__body {
    margin-top: 18px;
    font-size: 16px;
    color: var(--text-soft);
  }

  .universe__app {
    margin: 0;
    z-index: 2;
  }

  .universe__app img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: var(--shadow-sheet);
  }

  .universe__app figcaption {
    margin: 16px 0 0 20px;
    font-size: 28px;
    color: var(--ink);
    rotate: 2deg;
  }

  /* The board: cards and threads share its coordinates. */
  .universe__board {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .universe__threads {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }

  .universe__threads :global(path) {
    fill: none;
    stroke: var(--thread);
    stroke-width: 2;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    filter: drop-shadow(0 2px 1px rgb(60 20 10 / 0.35));
    transition:
      stroke-dashoffset 1.1s var(--ease-out) var(--delay, 0s),
      opacity 200ms;
  }

  .universe__board[data-waiting] :global(path) {
    stroke-dashoffset: 1;
  }

  .universe__board[data-focus] :global(path:not([data-lit])),
  .universe__board[data-focus] .universe__tag:not([data-lit]) {
    opacity: 0.25;
  }

  .universe__relations {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .universe__tag {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 4;
    padding: 4px 8px 2px;
    background: var(--paper);
    color: var(--thread);
    font-size: 24px;
    white-space: nowrap;
    box-shadow: var(--shadow-low);
    translate: -50% -50%;
    visibility: hidden;
  }

  .universe__tag[data-placed] {
    visibility: visible;
    transition: opacity 400ms var(--delay, 0s);
  }

  .universe__board[data-waiting] .universe__tag {
    opacity: 0;
  }

  .universe__card {
    --sheet: var(--paper-warm);
    position: absolute;
    z-index: 2;
    width: 230px;
    padding: 20px 18px 16px;
    background: var(--paper-warm);
    box-shadow: var(--shadow-card);
    border-top: 6px solid var(--category);
    cursor: grab;
    user-select: none;
    touch-action: none;
    pointer-events: auto;
    rotate: calc(var(--r) * 1deg);
    transition: box-shadow 160ms;
  }

  .universe__card[data-dragging] {
    cursor: grabbing;
    z-index: 5;
    box-shadow: 0 22px 40px rgb(40 25 10 / 0.35);
  }

  .universe__card--character {
    --category: var(--cat-character);
  }

  .universe__card--place {
    --category: var(--cat-place);
  }

  .universe__card--object {
    --category: var(--cat-object);
  }

  .universe__card--group {
    --category: var(--cat-group);
  }

  .universe__card--event {
    --category: var(--cat-event);
  }

  .universe__pin {
    top: -12px;
    left: calc(50% - 8px);
  }

  .universe__kind {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--category);
  }

  .universe__name {
    margin-top: 4px;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.15;
  }

  .universe__text {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-soft);
  }

  @media (min-width: 1200px) {
    .universe__card {
      left: calc(var(--x) * var(--u));
      top: calc(var(--y) * var(--u));
      width: calc(230 * var(--u));
      padding: calc(20 * var(--u)) calc(18 * var(--u)) calc(16 * var(--u));
    }

    .universe__name {
      font-size: max(16px, calc(20 * var(--u)));
    }

    .universe__tag,
    .universe__app figcaption {
      font-size: max(20px, calc(26 * var(--u)));
    }
  }

  @media (max-width: 1199.98px) {
    .universe .canvas {
      gap: 48px;
    }

    .universe__note {
      padding: 36px 24px 28px;
    }

    .universe__board {
      position: relative;
      inset: auto;
      height: 640px;
    }

    .universe__card {
      left: calc(var(--nx) * 1%);
      top: calc(var(--ny) * 1px + 12px);
      width: min(46%, 230px);
      padding: 16px 14px 12px;
      rotate: calc(var(--nr) * 1deg);
    }

    .universe__name {
      font-size: 17px;
    }

    .universe__text {
      font-size: 11px;
    }

    .universe__tag {
      font-size: 21px;
    }

    .universe__wide-only {
      display: none;
    }

    .universe__hint {
      font-size: 24px;
      color: var(--ink);
    }
  }
</style>
